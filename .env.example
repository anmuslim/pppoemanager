# ==========================================================
# PPPoE Manager - Konfigurasi Lingkungan (.env)
# ==========================================================

# Port aplikasi HTTP
PORT=3000
NODE_ENV=production

# Kunci Rahasia JWT (Wajib diisi dengan string acak dan aman minimal 32 karakter)
JWT_SECRET=rahasia_jwt_token_pppoe_manager_ubah_ini_dengan_string_acak_32karakter

# Kunci Enkripsi Password Router MikroTik (AES-256-CBC, panjang tepat 32 karakter atau string acak)
ENCRYPTION_KEY=kunci_enkripsi_32_karakter_min_1234567890

# ==========================================================
# Konfigurasi Database MySQL
# Jika variabel DB_* di bawah ini diisi, aplikasi akan otomatis
# menggunakan MySQL untuk menyimpan data router, user, dan log.
# Jika dikosongkan, aplikasi akan otomatis menggunakan fallback data/db.json.
# ==========================================================
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pppoe_user
DB_PASSWORD=PasswordKuatMySQL_123!
DB_NAME=pppoe_manager